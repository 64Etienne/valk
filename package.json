{
  "name": "valk-monorepo",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "overrides": {
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "@types/react": "19.1.17",
    "@types/react-dom": "19.1.11"
  },
  "scripts": {
    "web": "npm run dev -w @valk/web",
    "web:build": "npm run build -w @valk/web",
    "test": "npm test --workspaces --if-present",
    "mobile": "npm run start -w @valk/mobile"
  }
}
